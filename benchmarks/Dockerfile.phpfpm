FROM php:8.3-fpm-alpine

RUN apk add --no-cache nginx curl \
    && docker-php-ext-install opcache pcntl

# Konfigurasi Zend OPcache identik dengan BakpiaRun
RUN printf '%s\n' \
    'memory_limit=128M' \
    'opcache.enable=1' \
    'opcache.memory_consumption=128' \
    'opcache.interned_strings_buffer=16' \
    'opcache.max_accelerated_files=10000' \
    'opcache.validate_timestamps=0' \
    > /usr/local/etc/php/conf.d/99-bench-opcache.ini

COPY benchmarks/configs/nginx.conf /etc/nginx/nginx.conf
COPY benchmarks/configs/php-fpm-www.conf /usr/local/etc/php-fpm.d/zz-bench.conf
COPY public/ /app/public/

EXPOSE 8080

CMD ["sh", "-c", "php-fpm -D && exec nginx -g 'daemon off;'"]
